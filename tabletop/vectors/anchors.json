{
  "about": "Hand-worked cases from the Player's Guide (playtest edition, 9 November 2026). Every expected value was worked out by hand from the guide, not by the reference engine, so these check the engine. Only the fields given under expected are checked. Missing inputs take the defaults in tabletop/vectors/README.md.",
  "attacks": [
    {"id": "guide/attack", "note": "Worked example: An attack. KESTREL's rifle at a Medium target behind a barrier.",
     "attacker": {"attack": 7, "precision": 6, "systems": 7},
     "weapon": {"shots": 3, "damage": 6},
     "defender": {"reflex": 6, "countermeasures": 5, "armour": 2, "structure": 50},
     "situation": {"cover": 1},
     "expected": {"hit_target": 5, "glance_to": null, "crit_target": 1, "lock_target": 7, "lock_countered_to": 7,
                  "effective_armour": 2, "hit_damage": 4, "crit_damage": 6, "glance_damage": 1, "p_lock": 0.7,
                  "expected_damage_unlocked": 6.3}},
    {"id": "guide/attack-push", "note": "The same with Push: target 7. Push does not change the lock target.",
