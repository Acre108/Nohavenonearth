{
  "about": "Scripted attacks: given these d10 rolls in this order, the exact outcome. Traced by hand from the Player's Guide. Dice order: lock roll (only if the attack rolls one), one die per shot, lock and I Can See It rerolls (one per clean miss, earliest first, each die at most once), the full-Move reroll of the first hit, a crit die per hit if the crit target is 1 or more, a Brace die per damaging hit or glance if the target braces with a Brace target of 1 or more. Every die is used. Missing inputs take the defaults in tabletop/vectors/README.md.",
  "cases": [
    {"id": "guide/attack", "note": "Worked example: An attack.",
     "attacker": {"attack": 7, "precision": 6, "systems": 7},
     "weapon": {"shots": 3, "damage": 6},
     "defender": {"reflex": 6, "countermeasures": 5, "armour": 2, "structure": 50},
     "situation": {"cover": 1},
     "dice": [3, 2, 5, 8, 6, 1, 6],
     "expected": {"lock": "LOCK", "results": ["crit", "hit", "miss"], "damage": [6, 4, 0], "total": 10, "will_see_it": 0, "on_hit": false}},
    {"id": "guide/brace", "note": "Worked example: A brace. The rerolled 6 now hits; the crit and the last hit are halved.",
     "attacker": {"attack": 7, "precision": 6, "systems": 7},
     "weapon": {"shots": 3, "damage": 6},
     "defender": {"reflex": 6, "countermeasures": 5, "armour": 2, "structure": 50, "stance": "brace", "brace": 7},
     "situation": {"cover": 1},
     "dice": [3, 2, 5, 8, 6, 1, 6, 7, 4, 8, 2],
     "expected": {"lock": "LOCK", "results": ["crit", "hit", "hit"], "damage": [3, 4, 2], "total": 9}},
    {"id": "full-move/rerolled-die", "note": "The lock's reroll turns the first miss into a hit; that rerolled die is the first hit, so the full-Move reroll takes it, and the 9 stands.",
     "attacker": {"attack": 5, "precision": 5, "systems": 5},
     "weapon": {"shots": 2, "damage": 6},
     "defender": {"reflex": 5, "countermeasures": 5, "armour": 0, "structure": 50, "full_move": true},
     "situation": {"lock": "locked"},
     "dice": [7, 8, 3, 9],
     "expected": {"lock": "LOCKED", "results": ["miss", "miss"], "total": 0}},
    {"id": "full-move/hit-to-glance", "note": "The full-Move reroll can turn a hit into a glance. No crit die for a glance.",
     "attacker": {"attack": 5, "precision": 6, "systems": 5},
     "weapon": {"shots": 1, "damage": 10, "heavy": true},
     "defender": {"reflex": 5, "countermeasures": 5, "armour": 0, "structure": 50, "full_move": true},
     "situation": {"lock": "none"},
     "dice": [4, 6],
     "expected": {"lock": "NO ROLL", "results": ["glance"], "damage": [5], "total": 5}},
    {"id": "full-move/glance-untouched", "note": "A glance is not a hit, so the full-Move reroll goes to the later hit.",
     "attacker": {"attack": 5, "precision": 5, "systems": 5},
     "weapon": {"shots": 2, "damage": 10, "heavy": true},
     "defender": {"reflex": 5, "countermeasures": 5, "armour": 0, "structure": 50, "full_move": true},
     "situation": {"lock": "none"},
     "dice": [7, 2, 5],
     "expected": {"results": ["glance", "hit"], "damage": [5, 10], "total": 15}},
    {"id": "see-it/spent", "note": "Two misses and no lock: I Can See It costs 1 Will and rerolls both, earliest first.",
     "attacker": {"attack": 7, "precision": 6, "systems": 5},
     "weapon": {"shots": 3, "damage": 6},
     "defender": {"reflex": 6, "countermeasures": 5, "armour": 2, "structure": 50},
     "situation": {"cover": 1, "lock": "none", "see_it": true},
     "dice": [6, 7, 2, 1, 9, 5, 1],
     "expected": {"results": ["hit", "miss", "crit"], "damage": [4, 0, 6], "total": 10, "will_see_it": 1}},
    {"id": "see-it/not-needed", "note": "One miss and a lock: the lock's reroll covers it, so I Can See It costs nothing.",
     "attacker": {"attack": 7, "precision": 5, "systems": 5},
     "weapon": {"shots": 2, "damage": 6},
     "defender": {"reflex": 6, "countermeasures": 5, "armour": 2, "structure": 50},
     "situation": {"cover": 1, "lock": "locked", "see_it": true},
     "dice": [3, 8, 4],
     "expected": {"results": ["hit", "hit"], "damage": [4, 4], "total": 8, "will_see_it": 0}},
    {"id": "lock/countered", "note": "Systems 7 against CM 6: a 7 is COUNTERED, so no reroll.",
     "attacker": {"attack": 5, "precision": 5, "systems": 7},
     "weapon": {"shots": 1, "damage": 6},
     "defender": {"reflex": 5, "countermeasures": 6, "armour": 0, "structure": 50},
     "dice": [7, 6],
     "expected": {"lock": "COUNTERED", "results": ["miss"], "total": 0}},
    {"id": "lock/no-lock", "attacker": {"attack": 5, "precision": 5, "systems": 5},
     "weapon": {"shots": 1, "damage": 6},
     "defender": {"reflex": 5, "countermeasures": 5, "armour": 0, "structure": 50},
     "dice": [9, 6],
     "expected": {"lock": "NO LOCK", "results": ["miss"], "total": 0}},
    {"id": "brace/target-0-no-die", "note": "Brace 2 gives a Brace target of 0, so no Brace die is rolled; Precision 5 rolls no crit die.",
     "attacker": {"attack": 5, "precision": 5, "systems": 5},
     "weapon": {"shots": 1, "damage": 10},
     "defender": {"reflex": 7, "countermeasures": 5, "armour": 0, "structure": 50, "stance": "brace", "brace": 2},
     "situation": {"lock": "none"},
     "dice": [1],
     "expected": {"results": ["hit"], "damage": [10], "total": 10}},
    {"id": "brace/glance-halved", "note": "A damaging glance rolls to halve too: 8 // 2 = 4, halved to 2.",
     "attacker": {"attack": 5, "precision": 5, "systems": 5},
     "weapon": {"shots": 1, "damage": 8, "heavy": true},
     "defender": {"reflex": 7, "countermeasures": 5, "armour": 0, "structure": 50, "stance": "brace", "brace": 6},
     "situation": {"lock": "none"},
     "dice": [6, 3],
     "expected": {"results": ["glance"], "damage": [2], "total": 2}},
    {"id": "brace/zero-damage-no-die", "note": "A hit that Armour stops deals no damage, so it rolls no Brace die.",
     "attacker": {"attack": 5, "precision": 5, "systems": 5},
     "weapon": {"shots": 2, "damage": 4},
     "defender": {"reflex": 7, "countermeasures": 5, "armour": 4, "structure": 50, "stance": "brace", "brace": 6},
     "situation": {"lock": "none"},
     "dice": [1, 2],
     "expected": {"results": ["hit", "hit"], "damage": [0, 0], "total": 0}},
    {"id": "glance/ten", "note": "At target 9 a heavy weapon's 10 is a glance.",
     "attacker": {"attack": 12, "precision": 5, "systems": 5},
     "weapon": {"shots": 1, "damage": 8, "heavy": true},
     "defender": {"reflex": 5, "countermeasures": 5, "armour": 0, "structure": 50},
     "situation": {"lock": "none"},
     "dice": [10],
     "expected": {"results": ["glance"], "damage": [4], "total": 4}},
    {"id": "on-hit/glance-no-trigger", "note": "Stagger needs a hit; a glance doesn't trigger it.",
     "attacker": {"attack": 5, "precision": 5, "systems": 5},
     "weapon": {"shots": 1, "damage": 13, "ap": 3, "heavy": true, "on_hit": "stagger"},
     "defender": {"reflex": 5, "countermeasures": 5, "armour": 2, "structure": 50},
     "situation": {"lock": "none"},
     "dice": [6],
     "expected": {"results": ["glance"], "damage": [6], "on_hit": false}},
    {"id": "on-hit/hit-triggers", "attacker": {"attack": 5, "precision": 5, "systems": 5},
     "weapon": {"shots": 4, "damage": 7, "damage_type": "Explosive", "on_hit": "shred"},
     "defender": {"reflex": 5, "countermeasures": 5, "armour": 1, "structure": 50},
     "situation": {"lock": "none"},
     "dice": [9, 8, 4, 7],
     "expected": {"results": ["miss", "miss", "hit", "miss"], "total": 6, "on_hit": true}},
    {"id": "destroy", "attacker": {"attack": 9, "precision": 7, "systems": 5},
     "weapon": {"shots": 1, "damage": 19, "ap": 3, "heavy": true, "melee": true},
     "defender": {"reflex": 5, "countermeasures": 5, "armour": 3, "structure": 15},
     "situation": {"lock": "none", "charged": true},
     "dice": [5, 3],
     "expected": {"results": ["hit"], "damage": [19], "total": 19, "destroyed": true}}
  ]
}
